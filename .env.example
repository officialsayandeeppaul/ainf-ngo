# ---------------------------------------------------------------------------
# AINF Auth Platform — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public origin used to build Didit callbacks and email links.
# Local development with webhooks requires a tunnel, e.g.
#   cloudflared tunnel --url http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Clerk (authentication) ------------------------------------------------
# Dashboard -> API keys. The secret key must never reach client code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Clerk -> Webhooks endpoint signing secret (svix). Used by /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=""

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/account"

# --- Database (Neon Postgres) ---------------------------------------------
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the unpooled connection Prisma Migrate needs.
DATABASE_URL=""
DIRECT_URL=""

# --- Upstash Redis (rate limiting) ----------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Didit (identity / KYC verification) ----------------------------------
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
# Webhook destination "secret_shared_key" from the Didit console.
DIDIT_WEBHOOK_SECRET=""
# --- Verification method toggles ------------------------------------------
# true | false | unset (auto). Didit/PAN auto-on when their keys exist.
# OTP auto-on when both of those are off.
VERIFICATION_DIDIT="true"
VERIFICATION_PAN="true"
VERIFICATION_OTP="false"

# --- APITXT (PAN verification + transactional SMS) ------------------------
APITXT_AUTH_KEY=""
APITXT_BASE_URL="https://apitxt.com"
# Required only for SMS (not for panVerify). DLT is optional.
APITXT_SENDER_ID=""
APITXT_ROUTE="4"
# Leave false so OTP/SMS work without India DLT templates.
APITXT_REQUIRE_DLT="false"
APITXT_DLT_TEMPLATE_ID=""
APITXT_PE_ID=""
# Text OTP (sendOTP). Separate from the PAN key. No sender, template, or PE id.
APITXT_OTP_AUTH_KEY=""

# --- Resend (transactional email) -----------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AINF <noreply@theainf.in>"
# Only needed while FROM is still onboarding@resend.dev (Resend test mode).
RESEND_SANDBOX_TO_EMAIL=""
# Where super-admin security alerts are delivered.
SECURITY_ALERT_EMAIL=""

# --- Super admin bootstrap -------------------------------------------------
# Long random string. Only someone holding this may self-promote to SUPER_ADMIN,
# and only with TOTP MFA already enrolled. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SUPER_ADMIN_BOOTSTRAP_KEY=""
# Set to "true" only if a second super admin must be created.
SUPER_ADMIN_ALLOW_MULTIPLE="false"
# Unset = required in production only. Clerk authenticator MFA is a paid plan.
# Local/dev can bootstrap with the key alone when this is false.
SUPER_ADMIN_REQUIRE_MFA="false"

# --- Razorpay (membership checkout — test keys locally) --------------------
# Dashboard -> API Keys. The secret never ships to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Webhooks -> Secret. Different from the API key secret.
RAZORPAY_WEBHOOK_SECRET=""

# --- Crypto ----------------------------------------------------------------
# Salt for hashing PAN numbers before storage. Rotating this invalidates
# existing PAN hashes. Generate with the same command as above.
PAN_HASH_SALT=""
